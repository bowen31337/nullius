# deploy/evaluator/Containerfile — the frozen evaluator image
# (additions_spec_real_campaign_path.xml feature 6; architecture §12's
# determinism contract: "Pinned evaluator: container digest in
# evaluator_hash" and "Pinned libraries: lockfile inside the image; no
# runtime pip install").
#
# Built by deploy/evaluator/build_image.sh with podman or buildah — never
# docker — from the repository root, so NULLIUS_EVALUATOR_IMAGE names real,
# rebuildable content: a python:3.12-slim base pinned by digest, with the
# evaluator, cost-model, contract, snapshot and nulloracle workspace
# members installed from this commit's uv.lock via `uv sync --frozen` (no
# dependency resolution, no runtime pip install — uv itself arrives as a
# digest-pinned binary copied from its own image, not a pip install).
#
# OUT OF SCOPE TODAY: running an evaluation inside this image. The image is
# the provenance carrier only — the content evaluator_hash names — not an
# executable evaluation harness; it has no entrypoint and no CMD. A later
# feature may wire one. Until then, `podman run` against this image has
# nothing to invoke.

FROM ghcr.io/astral-sh/uv:0.11.19@sha256:b46b03ddfcfbf8f547af7e9eaefdf8a39c8cebcba7c98858d3162bd28cf536f6 AS uv

FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f

# architecture §12's determinism contract: single-threaded numerics and a
# stable iteration order for every eval worker built from this image.
ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    POLARS_MAX_THREADS=1 \
    PYTHONHASHSEED=0 \
    UV_PYTHON_DOWNLOADS=never

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app

# Exactly the paths build_image.sh refuses to build from when they carry
# uncommitted changes — keep this list and that script's COPIED_PATHS in
# agreement, since an image must name a commit.
COPY pyproject.toml uv.lock ./
COPY src/app ./src/app
COPY packages/evaluator/pyproject.toml packages/evaluator/pyproject.toml
COPY packages/evaluator/src packages/evaluator/src
COPY packages/cost-model/pyproject.toml packages/cost-model/pyproject.toml
COPY packages/cost-model/src packages/cost-model/src
COPY packages/contract/pyproject.toml packages/contract/pyproject.toml
COPY packages/contract/src packages/contract/src
COPY packages/snapshot/pyproject.toml packages/snapshot/pyproject.toml
COPY packages/snapshot/src packages/snapshot/src
COPY packages/nulloracle/pyproject.toml packages/nulloracle/pyproject.toml
COPY packages/nulloracle/src packages/nulloracle/src

RUN uv sync --frozen --no-dev --no-cache \
      --package evaluator --package cost-model --package nullius-contract \
      --package snapshot --package nulloracle

ENV PATH="/app/.venv/bin:${PATH}"
