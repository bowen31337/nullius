# Stage 2 feature 4 — one scheduled BingX VST rebalance slot, as a user
# service.  This file is written by the feature; installing and enabling it
# (linking it into ~/.config/systemd/user/ and starting the timer) is an
# operator step.  Nothing in this repository installs or enables it.
#
# The unit carries its **own environment**, because a systemd user service is
# not an interactive shell: it runs neither `~/.zshrc` (which exports
# `OP_SERVICE_ACCOUNT_TOKEN` from `~/.config/op/service-token`) nor the login
# PATH that puts `~/.local/bin` — where `uv` lives — ahead of the system's.
# Both are needed: `run.sh` first runs `op run` (which needs the service
# account) and then `uv run` (which needs `uv` on PATH).  The token's *value*
# never appears here; the ExecStart reads it from the operator's file, which
# is mode 0600 and lives outside the repository.
#
# The unit is a **oneshot**: a slot runs once, to completion, and exits.
# systemd never runs two instances of one service unit at a time, so a
# timer that fires while a slot is still running cannot start a second
# one — the rebalance cannot overlap itself.  That is also why the command
# is idempotent *inside* a slot: `rebalance_ts` is the slot's own 4-hour
# boundary, so even a manual re-run places nothing new.
#
# `./run.sh vst-rebalance` is the wrapper that injects only the BingX VST
# sub-account key (`.env.vst.tpl`, never `.env.tpl`) through `op run` and
# defaults `DATABASE_URL` to `~/.local/share/nullius/vst.db`, which is the
# one store the guard, the cancels, the reconcile and the placements all
# use.  It must run from the repository root, because the book path is
# relative to it and `run.sh` resolves the workspace from its own location.

[Unit]
Description=nullius scheduled BingX VST rebalance (one 4-hour slot)
Documentation=file:/%h/projects/nullius/deploy/systemd/nullius-vst-rebalance.timer
# The venue is remote, so wait for the network before a slot starts; a slot
# that cannot reach the venue places nothing and exits 1, which the timer's
# next firing retries.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The repository root.  `%h` is the operator's home; edit this line (and the
# matching one in the timer's unit) if the checkout lives elsewhere.
WorkingDirectory=%h/projects/nullius
# `uv` lives in the operator's ~/.local/bin, which a service does not inherit.
# It goes first so the pinned interpreter wins over any system copy; the
# system directories follow for `op`, `/bin/sh` and the ordinary tools.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One slot.  `run.sh` already injects the VST key and the store URL; the
# book is the synthetic Stage 0 book this feature ships with.
#
# The token is read from the operator's own file (mode 0600) at start, inside
# the shell, and never written into this unit.  `$$` is systemd's escape for a
# literal dollar — a bare `$(cat …)` would be consumed by systemd's own
# substitution and reach the shell empty.  The assignment is a separate
# statement — so it needs its own `export`, unlike the `VAR=… cmd` prefix form
# — and the `": "${VAR:?…}"` guard makes a missing or unreadable token file a
# *failure* (exit 2, outside SuccessExitStatus below) with a message naming
# the file, rather than a run of `op` with no credentials.  `%h` stays a
# systemd specifier because it must resolve here; only the dollar is doubled.
ExecStart=/bin/sh -c 'OP_SERVICE_ACCOUNT_TOKEN="$$(cat %h/.config/op/service-token)"; export OP_SERVICE_ACCOUNT_TOKEN; : "$${OP_SERVICE_ACCOUNT_TOKEN:?1Password service token unreadable — see %h/.config/op/service-token}"; exec %h/projects/nullius/run.sh vst-rebalance --book packages/router/tests/fixtures/bingx_vst/synthetic_book.json'
# A slot that fails (exit 1: a refused leg, exit 3: a daily-loss halt) is
# recorded by systemd and by the JSON line the command prints to the
# journal; it is not restarted here, because the timer's next slot handles
# the retry and the daily-loss halt must not be hammered.
Restart=no
# The slot's exit 3 (daily-loss halt) is a *refusal*, not a crash: report it
# in the journal without systemd treating the unit as failed.
SuccessExitStatus=0 1 3
