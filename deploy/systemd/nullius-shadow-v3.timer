# Fires the paper-only shadow book once a day, 30 minutes after the daily lake
# refresh (nullius-shadow.timer, 09:30 UTC), which finishes in about 4 minutes.
# Enabling it is an operator step: `systemctl --user enable --now nullius-shadow-v3.timer`.

[Unit]
Description=nullius paper-only forward shadow v3 timer (daily)
Documentation=file:/%h/projects/nullius/deploy/systemd/nullius-shadow-v3.service

[Timer]
OnCalendar=*-*-* 10:00:00 UTC
Persistent=true
AccuracySec=1min
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
