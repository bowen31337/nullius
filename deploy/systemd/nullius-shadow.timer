# additions_spec_forward_shadow.xml, "Forward Shadow" category, feature 4 —
# the timer that fires the daily forward-shadow refresh. Written by the
# feature; enabling it is an operator step
# (`systemctl --user enable --now nullius-shadow.timer`). Nothing in this
# repository installs or enables it.
#
# Once a day, at 02:30 UTC — ahead of the 04:05 UTC rebalance slot
# (nullius-vst-rebalance.timer), so a freshly rebuilt book is already on
# disk by the time that slot reads it, were an operator to point its
# `--book` flag at SHADOW_OUT (a separate operator step; see this unit's
# nullius-shadow.service comment). Scheduled in UTC with the offset spelled
# on the line, the same convention the VST and canary timers use, so the
# schedule is UTC whatever the host's clock is set to.

[Unit]
Description=nullius daily forward-shadow refresh timer
Documentation=file:/%h/projects/nullius/deploy/systemd/nullius-shadow.service

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
# A firing missed because the machine was off (a laptop, a reboot) is run on
# the next boot: the refresh is idempotent (the hold rule in `shadow-book`,
# plus the incremental backfill window), so catching up is safe.
Persistent=true
# The service is a oneshot, so systemd will not start a second run while one
# is still running.
AccuracySec=1min
# No jitter: one firing a day is nowhere near the thundering-herd scale that
# RandomizedDelaySec exists to spread.
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
