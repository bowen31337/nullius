# Campaign secrets + config, injected by `op run` (1Password CLI).
# Copy to .env.campaign.tpl and replace each op:// reference with your vault's
# item path. The research keys are NULLIUS_-prefixed and never share a name
# with claw-forge's own ANTHROPIC_API_KEY. This file carries references, never
# secret values; .env.campaign.tpl is git-ignored.

# -- provider keys (a single-vendor Anthropic campaign needs only the first) ---
NULLIUS_ANTHROPIC_API_KEY=op://nullius/anthropic-research/api-key
# add the rest only if authoring-config.json pins a model from them
# NULLIUS_OPENAI_API_KEY=op://nullius/openai-research/api-key
# NULLIUS_GOOGLE_API_KEY=op://nullius/google-research/api-key
# NULLIUS_DEEPSEEK_API_KEY=op://nullius/deepseek-research/api-key
# self-hosted depth model (optional): a base URL, and a key only if it needs one
# NULLIUS_SELF_HOSTED_BASE_URL=http://127.0.0.1:8000/v1
# NULLIUS_SELF_HOSTED_API_KEY=op://nullius/selfhosted/api-key

# -- config file locations (plain paths, not secrets) --------------------------
NULLIUS_AUTHORING_CONFIG=deploy/campaign/authoring-config.json
# claude-opus-5-5, claude-sonnet-5-5 and the Fable family take `effort`
# (low|medium|high|xhigh|max), not temperature/top_p/top_k -- a pin that sets
# temperature for one of them is refused at load (unsupported_sampling).
NULLIUS_EVALUATION_CONFIG=deploy/campaign/evaluation-config.json
# optional: an admitted exploration-policy source; unset uses the baseline
# NULLIUS_EXPLORATION_POLICY=deploy/campaign/policy.py

# -- lake root (a plain path, not a secret) ------------------------------------
# Must match where `./run.sh lake-backfill` / `./run.sh lake-seal` sealed --
# both default LAKE to $HOME/.local/share/nullius/lake, but op run --env-file
# does not expand $HOME, so give the absolute path.
LAKE_ROOT=/home/YOUR_USER/.local/share/nullius/lake

# -- null sidecar (plain path + one key reference) -----------------------------
# optional: defaults to <LAKE_ROOT>/null/sidecar.enc when unset
# NULL_SIDECAR_PATH=/home/YOUR_USER/.local/share/nullius/lake/null/sidecar.enc
# The op:// item's stored value must read exactly "hex:<64 hex characters>"
# (32 raw bytes). Losing this key makes all FDR history uninterpretable --
# every campaign's planted-null labels, permanently -- so back it up outside
# the lake the same day you generate it.
NULL_SIDECAR_KEY_REF=op://nullius/null-sidecar/key

# -- evaluator inputs (leave the last two unset to use the member defaults) ----
# the digest-pinned reference `./run.sh evaluator-image` prints -- never a
# tag, because evaluator_hash requires a real, rebuildable digest
NULLIUS_EVALUATOR_IMAGE=localhost/nullius-evaluator@sha256:...
# NULLIUS_COST_MODEL_PATH=deploy/campaign/cost-model.yaml
# NULLIUS_EVALUATOR_CONFIG=deploy/campaign/evaluator.yaml
