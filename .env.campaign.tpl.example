# Campaign secrets + config, injected by `op run` (1Password CLI).
# Copy to .env.campaign.tpl and replace each op:// reference with your vault's
# item path. The research keys are NULLIUS_-prefixed and never share a name
# with claw-forge's own ANTHROPIC_API_KEY. This file carries references, never
# secret values; .env.campaign.tpl is git-ignored.

# -- provider keys (only the vendors your pins use need a real value) ----------
NULLIUS_ANTHROPIC_API_KEY=op://nullius/anthropic-research/api-key
NULLIUS_OPENAI_API_KEY=op://nullius/openai-research/api-key
NULLIUS_GOOGLE_API_KEY=op://nullius/google-research/api-key
NULLIUS_DEEPSEEK_API_KEY=op://nullius/deepseek-research/api-key
# self-hosted depth model (optional): a base URL, and a key only if it needs one
# NULLIUS_SELF_HOSTED_BASE_URL=http://127.0.0.1:8000/v1
# NULLIUS_SELF_HOSTED_API_KEY=op://nullius/selfhosted/api-key

# -- config file locations (plain paths, not secrets) --------------------------
NULLIUS_AUTHORING_CONFIG=deploy/campaign/authoring-config.json
NULLIUS_EVALUATION_CONFIG=deploy/campaign/evaluation-config.json
# optional: an admitted exploration-policy source; unset uses the baseline
# NULLIUS_EXPLORATION_POLICY=deploy/campaign/policy.py

# -- evaluator inputs (leave unset to use the member defaults) -----------------
# NULLIUS_COST_MODEL_PATH=deploy/campaign/cost-model.yaml
# NULLIUS_EVALUATOR_CONFIG=deploy/campaign/evaluator.yaml
# NULLIUS_EVALUATOR_IMAGE=ghcr.io/nullius/evaluator@sha256:...
